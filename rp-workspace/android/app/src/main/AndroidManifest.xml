<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 【2026-09-08 用户需求】所有文件访问（MANAGE_EXTERNAL_STORAGE）：突破 app 沙箱，
         运行时/导入导出可直读直写 /sdcard（Android 11+ Scoped Storage 的免 SAF 通道；
         需用户在系统设置里一次性授予「所有文件访问权限」——MainActivity 首启引导 + JS 桥） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.DSHTavern"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 免 root 通道 1：TauriTavern（或任意文件管理器）「分享」zip 给 DSHTavern -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
                <!-- 【W-8 2026-09-21 系统轻入口】分享 sheet 接收扩展到文本/链接与图片：
                     · text/plain —— 浏览器/其它 App 分享 URL 用的就是它（EXTRA_TEXT 载 URL）
                     · image/*    —— 角色卡头像 / 参考图
                     分发逻辑见 MainActivity.handleIncomingIntent（按 intent.type 分派，
                     三类都落 filesDir/inbox/ 并通知前端）。 -->
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- §4.16.2 B 类：通知/外部深链 dsht://session/<id> → 打开对应会话
                 （MainActivity onNewIntent/onCreate 派发 locate-session 给前端消费） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dsht" android:host="session" />
            </intent-filter>
        </activity>

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!-- specialUse（API 34+ 实际生效）：dataSync 在 Android 15+ 有 6 小时强制超时
                 （FGS 超时后系统停服务 → node 失去前台庇护被 LMK 杀 → 长会话必断，真机
                 鸿蒙 6 实证）。DSH 运行时是常驻本地 web 服务，不属于周期性数据同步。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="常驻本地 DSH 运行时（node web 服务 + WebView 前端），非数据同步" />
        </service>

        <!-- Shizuku 通道（W-2）：设备能力（截屏/输入/通知）经 shell(uid 2000) 执行。
             见 docs/SHIZUKU-RESEARCH-2026-09-21.md。
             · 不加任何 <uses-permission moe.shizuku.manager.permission.*>——
               Shizuku 的 Apache-2.0 §6 明确禁止第三方声明该权限族；
               v11+ 用自实现权限（Shizuku.checkSelfPermission/requestPermission）。
             · android:permission 的作用是**保护本 provider 不被普通 app 访问**（官方注释语义）。
             · exported=true 是必须的：Shizuku 官方 App 需跨进程访问它。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- W-4 守门人：danger 档设备操作的批准按钮回调。
             exported=false —— 只有系统通知栏的 PendingIntent 能触发它
             （PendingIntent 以本 App 身份发出，不受 exported 限制），
             其它应用无法伪造「批准」。 -->
        <receiver
            android:name=".GateReceiver"
            android:exported="false" />

        <!-- 【W-8 2026-09-21 系统轻入口】快速设置磁贴「DSH 局域网」。
             必须 exported=true 且带 ACTION_QS_TILE intent-filter，并声明 TOGGLEABLE_TILE 元数据
             —— 这是系统「快捷设置」发现磁贴的唯一途径（由 SystemUI 拉起，非本 App）。
             权限 BIND_QUICK_SETTINGS_TILE 确保只有 SystemUI 能绑定它。
             为何只做「切 LAN」不做「回会话」：见 LanTileService 头注（点图标即回前台，多做无增量）。 -->
        <service
            android:name=".LanTileService"
            android:exported="true"
            android:label="DSH 局域网"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
