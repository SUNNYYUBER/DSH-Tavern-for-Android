{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "types": ["node"],
    "lib": ["ES2022", "ES2023.Array", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": ["tests", "src"],
  "exclude": ["node_modules", "lib"]
}
