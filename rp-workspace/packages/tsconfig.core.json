    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "types": [],
    "lib": ["ES2022", "ES2023.Array"],
    "skipLibCheck": true
  },
  "include": [
    "src/dsht-plugin-shared",
